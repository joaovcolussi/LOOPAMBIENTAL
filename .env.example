DATABASE_URL="mysql://loopambiental:loopambiental_local@localhost:3306/loopambiental"
REDIS_URL="redis://localhost:6379"
PORT=3001
WEB_ORIGIN="http://localhost:3000"
ADMIN_EMAILS="admin@loopambiental.com"
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_FROM="LOOP AMBIENTAL <no-reply@loopambiental.com>"
WEB_PUBLIC_URL="http://localhost:3000"
API_PUBLIC_URL="http://localhost:3001"
FIELD_ENCRYPTION_KEY="configure-a-strong-secret-in-production"
# Ambiente de estudo/demonstração: pagamentos simulados e recursos de teste.
DEMO_MODE=true
# simulated (padrão fora de produção) | mercadopago
PAYMENT_PROVIDER=simulated
# Login exige e-mail verificado (link chega no Mailpit em http://localhost:8025).
REQUIRE_EMAIL_VERIFICATION=true
# Exige MFA para administradores (recomendado em produção).
REQUIRE_ADMIN_MFA=false
# json | pretty (padrão: json em produção)
LOG_FORMAT=pretty
# Token Bearer para /api/v1/metrics (obrigatório em produção).
METRICS_TOKEN=
MP_ACCESS_TOKEN="configure-mercado-pago-access-token"
MP_WEBHOOK_SECRET="configure-mercado-pago-webhook-secret"
MP_API_URL="https://api.mercadopago.com"
STORAGE_ENDPOINT="http://localhost:9000"
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="loopambiental-listings"
STORAGE_ACCESS_KEY="loopambiental"
STORAGE_SECRET_KEY="loopambiental_local"
AUTH_THROTTLE_LIMIT=20
THROTTLE_LIMIT=120
