FROM node:22-alpine AS build

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.15.5 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json turbo.json ./
COPY apps/worker/package.json apps/worker/package.json
COPY packages/database/package.json packages/database/package.json
RUN pnpm install --frozen-lockfile

COPY apps/worker apps/worker
RUN pnpm --filter @loopambiental/worker build

FROM node:22-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S loopambiental && adduser -S loopambiental -G loopambiental

COPY --from=build --chown=loopambiental:loopambiental /workspace/node_modules ./node_modules
COPY --from=build --chown=loopambiental:loopambiental /workspace/apps/worker/node_modules ./apps/worker/node_modules
COPY --from=build --chown=loopambiental:loopambiental /workspace/apps/worker/dist ./apps/worker/dist
COPY --from=build --chown=loopambiental:loopambiental /workspace/apps/worker/package.json ./apps/worker/package.json

USER loopambiental
CMD ["node", "apps/worker/dist/main.js"]
