FROM node:22-alpine AS build

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.15.5 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json turbo.json ./
COPY apps/api/package.json apps/api/package.json
COPY apps/worker/package.json apps/worker/package.json
COPY apps/web/package.json apps/web/package.json
COPY packages/database/package.json packages/database/package.json
RUN pnpm install --frozen-lockfile

COPY apps/api apps/api
COPY packages/database packages/database
RUN pnpm --filter @loopambiental/database generate
RUN pnpm --filter @loopambiental/api build

FROM node:22-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S loopambiental && adduser -S loopambiental -G loopambiental

COPY --from=build --chown=loopambiental:loopambiental /workspace/node_modules ./node_modules
COPY --from=build --chown=loopambiental:loopambiental /workspace/apps/api/node_modules ./apps/api/node_modules
COPY --from=build --chown=loopambiental:loopambiental /workspace/packages/database/node_modules ./packages/database/node_modules
COPY --from=build --chown=loopambiental:loopambiental /workspace/apps/api/dist ./apps/api/dist
COPY --from=build --chown=loopambiental:loopambiental /workspace/packages/database/node_modules ./apps/api/dist/packages/database/node_modules
COPY --from=build --chown=loopambiental:loopambiental /workspace/apps/api/package.json ./apps/api/package.json
COPY --from=build --chown=loopambiental:loopambiental /workspace/packages/database ./packages/database
COPY --from=build --chown=loopambiental:loopambiental /workspace/package.json ./package.json

USER loopambiental
EXPOSE 3001
CMD ["node", "apps/api/dist/apps/api/src/main.js"]
