FROM node:22-alpine AS build

WORKDIR /workspace
RUN corepack enable && corepack prepare pnpm@9.15.5 --activate

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.json turbo.json ./
COPY apps/web/package.json apps/web/package.json
RUN pnpm install --frozen-lockfile

COPY apps/web apps/web
ARG NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
RUN pnpm --filter @loopambiental/web build

FROM node:22-alpine AS runtime

WORKDIR /app
ENV NODE_ENV=production
RUN addgroup -S loopambiental && adduser -S loopambiental -G loopambiental

COPY --from=build --chown=loopambiental:loopambiental /workspace/apps/web/.next/standalone ./
COPY --from=build --chown=loopambiental:loopambiental /workspace/apps/web/.next/static ./apps/web/.next/static
COPY --from=build --chown=loopambiental:loopambiental /workspace/apps/web/public ./apps/web/public

USER loopambiental
EXPOSE 3000
CMD ["node", "apps/web/server.js"]
