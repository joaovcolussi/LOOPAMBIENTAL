generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  ACTIVE
  PENDING
  BLOCKED
  DELETED

  @@map("user_status")
}

enum PlatformRole {
  USER
  MODERATOR
  ADMIN

  @@map("platform_role")
}

enum ModerationCaseStatus {
  OPEN
  IN_REVIEW
  APPROVED
  REJECTED

  @@map("moderation_case_status")
}

enum ModerationActionType {
  APPROVE
  REJECT

  @@map("moderation_action_type")
}

enum ProposalStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  CANCELLED
  EXPIRED

  @@map("proposal_status")
}

enum DealStatus {
  OPEN
  AWAITING_DOCUMENTS
  AWAITING_PAYMENT
  AWAITING_PICKUP
  IN_TRANSIT
  DELIVERED
  COMPLETED
  DISPUTED
  CANCELLED

  @@map("deal_status")
}

enum NotificationType {
  PROPOSAL_CREATED
  PROPOSAL_COUNTERED
  PROPOSAL_ACCEPTED
  PROPOSAL_REJECTED
  PROPOSAL_CANCELLED
  MESSAGE_RECEIVED
  COMPANY_VERIFICATION_REQUESTED
  COMPANY_VERIFIED
  COMPANY_VERIFICATION_REJECTED
  SAVED_SEARCH_MATCH
  SYSTEM

  @@map("notification_type")
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET

  @@map("auth_token_type")
}

enum CompanyStatus {
  ACTIVE
  PENDING
  BLOCKED

  @@map("company_status")
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED

  @@map("verification_status")
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  MEMBER

  @@map("company_member_role")
}

enum CompanyDocumentType {
  CNPJ_CARD
  SOCIAL_CONTRACT
  ADDRESS_PROOF
  OPERATING_LICENSE
  ENVIRONMENTAL_LICENSE
  OTHER

  @@map("company_document_type")
}

enum CompanyDocumentStatus {
  PENDING
  APPROVED
  REJECTED

  @@map("company_document_status")
}

enum CompanyVerificationStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED

  @@map("company_verification_status")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED

  @@map("invitation_status")
}

enum ReportTargetType {
  LISTING
  COMPANY
  USER
  MESSAGE

  @@map("report_target_type")
}

enum ReportReason {
  COUNTERFEIT
  PRODUCT_QUALITY
  MISLEADING
  CONTACT_ABUSE
  SPAM
  ILLEGAL
  HAZARDOUS
  UNDOCUMENTED
  OTHER

  @@map("report_reason")
}

enum ReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED

  @@map("report_status")
}

enum SavedSearchFrequency {
  NONE
  DAILY
  WEEKLY

  @@map("saved_search_frequency")
}

enum ListingType {
  BUY
  SELL

  @@map("listing_type")
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  PUBLISHED
  PAUSED
  NEGOTIATING
  CLOSED
  EXPIRED
  REJECTED
  ARCHIVED

  @@map("listing_status")
}

enum ListingFrequency {
  ONE_TIME
  WEEKLY
  MONTHLY
  CONTINUOUS

  @@map("listing_frequency")
}

enum RiskClassification {
  NON_HAZARDOUS
  HAZARDOUS
  UNKNOWN

  @@map("risk_classification")
}

enum ListingMediaStatus {
  READY
  REJECTED

  @@map("listing_media_status")
}

enum ContactVisibility {
  PRIVATE
  MEMBERS
  PUBLIC

  @@map("contact_visibility")
}

enum PaymentStatus {
  INITIATED
  PENDING
  PAID
  FAILED
  CANCELLED
  REFUNDED

  @@map("payment_status")
}

enum LogisticsRequestStatus {
  REQUESTED
  QUOTED
  ACCEPTED
  IN_TRANSIT
  COMPLETED
  CANCELLED

  @@map("logistics_request_status")
}

enum LogisticsQuoteStatus {
  ACTIVE
  ACCEPTED
  REJECTED
  EXPIRED

  @@map("logistics_quote_status")
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

enum ContactUnlockSource {
  PLAN
  CREDIT
  ONE_TIME

  @@map("contact_unlock_source")
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  DISPATCHED
  PROCESSED
  FAILED

  @@map("outbox_event_status")
}

model User {
  id                       String                    @id @default(uuid()) @db.VarChar(36)
  name                     String                    @db.VarChar(150)
  email                    String                    @unique @db.VarChar(320)
  passwordHash             String?                   @map("password_hash")
  status                   UserStatus                @default(PENDING)
  platformRole             PlatformRole              @default(USER) @map("platform_role")
  emailVerifiedAt          DateTime?                 @map("email_verified_at") @db.DateTime(3)
  createdAt                DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt                DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt                DateTime?                 @map("deleted_at") @db.DateTime(3)
  memberships              CompanyMember[]
  listings                 Listing[]                 @relation("listing_creator")
  sessions                 Session[]
  moderationActions        ModerationAction[]
  favorites                Favorite[]
  proposals                Proposal[]
  proposalRevisions        ProposalRevision[]
  conversationParticipants ConversationParticipant[]
  messages                 Message[]
  notifications            Notification[]
  authTokens               AuthToken[]
  logisticsRequests        LogisticsRequest[]
  logisticsQuotes          LogisticsQuote[]
  listingMedia             ListingMedia[]
  carouselSlidesUpdated    HomeCarouselSlide[]       @relation("carousel_slide_updater")
  auditLogs                AuditLog[]
  companyDocumentsUploaded CompanyDocument[]         @relation("company_document_uploader")
  companyDocumentsReviewed CompanyDocument[]         @relation("company_document_reviewer")
  verificationsRequested   CompanyVerification[]     @relation("company_verification_requester")
  verificationsReviewed    CompanyVerification[]     @relation("company_verification_reviewer")
  invitationsSent          CompanyInvitation[]       @relation("company_invitation_inviter")
  reportsCreated           Report[]                  @relation("report_reporter")
  reportsReviewed          Report[]                  @relation("report_reviewer")
  reportsAgainst           Report[]                  @relation("report_reported_user")
  listingStatusChanges     ListingStatusHistory[]    @relation("listing_status_actor")
  dealStatusChanges        DealStatusHistory[]       @relation("deal_status_actor")
  savedSearches            SavedSearch[]             @relation("user_saved_searches")
  platformSettingsUpdated  PlatformSetting[]         @relation("platform_setting_updater")
  contactUnlocks           ContactUnlock[]           @relation("contact_unlock_user")
  reviewsAuthored          Review[]                  @relation("review_author")

  @@index([status])
  @@index([platformRole])
  @@map("users")
}

model Session {
  id                String   @id @default(uuid()) @db.VarChar(36)
  userId            String   @map("user_id") @db.VarChar(36)
  tokenHash         String   @unique @map("token_hash") @db.VarChar(128)
  userAgent         String?  @map("user_agent") @db.VarChar(500)
  ipAddress         String?  @map("ip_address") @db.VarChar(64)
  expiresAt         DateTime @map("expires_at") @db.DateTime(3)
  absoluteExpiresAt DateTime @map("absolute_expires_at") @db.DateTime(3)
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("sessions")
}

model Company {
  id                  String                @id @default(uuid()) @db.VarChar(36)
  slug                String?               @unique @db.VarChar(220)
  legalName           String                @map("legal_name") @db.VarChar(200)
  tradeName           String?               @map("trade_name") @db.VarChar(200)
  taxIdHash           String?               @unique @map("tax_id_hash") @db.VarChar(128)
  status              CompanyStatus         @default(PENDING)
  verification        VerificationStatus    @default(UNVERIFIED)
  description         String?               @db.Text
  city                String?               @db.VarChar(120)
  state               String?               @db.Char(2)
  contactName         String?               @map("contact_name") @db.VarChar(150)
  contactEmail        String?               @map("contact_email") @db.VarChar(320)
  contactWhatsapp     String?               @map("contact_whatsapp") @db.VarChar(20)
  taxIdEncrypted      String?               @map("tax_id_encrypted") @db.Text
  addressLine         String?               @map("address_line") @db.VarChar(200)
  addressNumber       String?               @map("address_number") @db.VarChar(20)
  addressDistrict     String?               @map("address_district") @db.VarChar(120)
  addressPostalCode   String?               @map("address_postal_code") @db.VarChar(12)
  contactVisibility   ContactVisibility     @default(PRIVATE) @map("contact_visibility")
  latitude            Decimal?              @db.Decimal(10, 7)
  longitude           Decimal?              @db.Decimal(10, 7)
  createdAt           DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  deletedAt           DateTime?             @map("deleted_at") @db.DateTime(3)
  members             CompanyMember[]
  listings            Listing[]
  documents           CompanyDocument[]     @relation("company_documents")
  verifications       CompanyVerification[] @relation("company_verifications")
  invitations         CompanyInvitation[]   @relation("company_invitations")
  reportsAgainst      Report[]              @relation("report_company")
  proposalsMade       Proposal[]            @relation("proposer_company")
  dealsAsBuyer        Deal[]                @relation("buyer_company")
  dealsAsSeller       Deal[]                @relation("seller_company")
  paymentTransactions PaymentTransaction[]
  subscriptions       Subscription[]
  contactUnlocks      ContactUnlock[]       @relation("company_contact_unlocks")
  reviewsAsReviewer   Review[]              @relation("review_reviewer_company")
  reviewsReceived     Review[]              @relation("review_reviewed_company")
  ratingAverage       Decimal               @default(0) @map("rating_average") @db.Decimal(3, 2)
  ratingCount         Int                   @default(0) @map("rating_count")

  @@index([status, verification])
  @@map("companies")
}

model CompanyMember {
  companyId String            @map("company_id") @db.VarChar(36)
  userId    String            @map("user_id") @db.VarChar(36)
  role      CompanyMemberRole @default(MEMBER)
  joinedAt  DateTime          @default(now()) @map("joined_at") @db.DateTime(3)
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([companyId, userId])
  @@index([userId])
  @@map("company_members")
}

model CompanyDocument {
  id               String                @id @default(uuid()) @db.VarChar(36)
  companyId        String                @map("company_id") @db.VarChar(36)
  uploadedByUserId String                @map("uploaded_by_user_id") @db.VarChar(36)
  type             CompanyDocumentType
  fileName         String                @map("file_name") @db.VarChar(255)
  storageKey       String                @unique @map("storage_key") @db.VarChar(255)
  mimeType         String                @map("mime_type") @db.VarChar(80)
  sizeBytes        Int                   @map("size_bytes")
  sha256           String                @db.Char(64)
  status           CompanyDocumentStatus @default(PENDING)
  reviewedByUserId String?               @map("reviewed_by_user_id") @db.VarChar(36)
  reviewedAt       DateTime?             @map("reviewed_at") @db.DateTime(3)
  reviewNotes      String?               @map("review_notes") @db.Text
  createdAt        DateTime              @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime              @updatedAt @map("updated_at") @db.DateTime(3)
  company          Company               @relation("company_documents", fields: [companyId], references: [id], onDelete: Restrict)
  uploadedBy       User                  @relation("company_document_uploader", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  reviewedBy       User?                 @relation("company_document_reviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([uploadedByUserId])
  @@index([reviewedByUserId])
  @@map("company_documents")
}

model CompanyVerification {
  id                String                    @id @default(uuid()) @db.VarChar(36)
  companyId         String                    @map("company_id") @db.VarChar(36)
  requestedByUserId String                    @map("requested_by_user_id") @db.VarChar(36)
  status            CompanyVerificationStatus @default(PENDING)
  notes             String?                   @db.Text
  reviewNotes       String?                   @map("review_notes") @db.Text
  reviewedByUserId  String?                   @map("reviewed_by_user_id") @db.VarChar(36)
  reviewedAt        DateTime?                 @map("reviewed_at") @db.DateTime(3)
  createdAt         DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  company           Company                   @relation("company_verifications", fields: [companyId], references: [id], onDelete: Restrict)
  requestedBy       User                      @relation("company_verification_requester", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  reviewedBy        User?                     @relation("company_verification_reviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([status, createdAt])
  @@index([requestedByUserId])
  @@index([reviewedByUserId])
  @@map("company_verifications")
}

model CompanyInvitation {
  id              String            @id @default(uuid()) @db.VarChar(36)
  companyId       String            @map("company_id") @db.VarChar(36)
  email           String            @db.VarChar(320)
  role            CompanyMemberRole @default(MEMBER)
  invitedByUserId String            @map("invited_by_user_id") @db.VarChar(36)
  tokenHash       String            @unique @map("token_hash") @db.VarChar(128)
  status          InvitationStatus  @default(PENDING)
  expiresAt       DateTime          @map("expires_at") @db.DateTime(3)
  acceptedAt      DateTime?         @map("accepted_at") @db.DateTime(3)
  createdAt       DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime          @updatedAt @map("updated_at") @db.DateTime(3)
  company         Company           @relation("company_invitations", fields: [companyId], references: [id], onDelete: Restrict)
  invitedBy       User              @relation("company_invitation_inviter", fields: [invitedByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([email, status])
  @@index([invitedByUserId])
  @@map("company_invitations")
}

model Report {
  id               String           @id @default(uuid()) @db.VarChar(36)
  reporterUserId   String           @map("reporter_user_id") @db.VarChar(36)
  targetType       ReportTargetType @map("target_type")
  listingId        String?          @map("listing_id") @db.VarChar(36)
  companyId        String?          @map("company_id") @db.VarChar(36)
  reportedUserId   String?          @map("reported_user_id") @db.VarChar(36)
  messageId        String?          @map("message_id") @db.VarChar(36)
  reason           ReportReason
  details          String?          @db.Text
  status           ReportStatus     @default(OPEN)
  resolutionNotes  String?          @map("resolution_notes") @db.Text
  reviewedByUserId String?          @map("reviewed_by_user_id") @db.VarChar(36)
  reviewedAt       DateTime?        @map("reviewed_at") @db.DateTime(3)
  createdAt        DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.DateTime(3)
  reporter         User             @relation("report_reporter", fields: [reporterUserId], references: [id], onDelete: Restrict)
  reviewedBy       User?            @relation("report_reviewer", fields: [reviewedByUserId], references: [id], onDelete: Restrict)
  listing          Listing?         @relation("report_listing", fields: [listingId], references: [id], onDelete: Restrict)
  company          Company?         @relation("report_company", fields: [companyId], references: [id], onDelete: Restrict)
  reportedUser     User?            @relation("report_reported_user", fields: [reportedUserId], references: [id], onDelete: Restrict)
  message          Message?         @relation("report_message", fields: [messageId], references: [id], onDelete: Restrict)

  @@index([status, createdAt])
  @@index([reporterUserId, createdAt])
  @@index([targetType, status])
  @@index([listingId])
  @@index([companyId])
  @@index([reportedUserId])
  @@index([messageId])
  @@index([reviewedByUserId])
  @@map("reports")
}

model ListingStatusHistory {
  id          String         @id @default(uuid()) @db.VarChar(36)
  listingId   String         @map("listing_id") @db.VarChar(36)
  fromStatus  ListingStatus? @map("from_status")
  toStatus    ListingStatus  @map("to_status")
  actorUserId String?        @map("actor_user_id") @db.VarChar(36)
  reason      String?        @db.VarChar(160)
  createdAt   DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  listing     Listing        @relation("listing_status_history", fields: [listingId], references: [id], onDelete: Cascade)
  actor       User?          @relation("listing_status_actor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([listingId, createdAt])
  @@index([actorUserId])
  @@map("listing_status_history")
}

model DealStatusHistory {
  id          String      @id @default(uuid()) @db.VarChar(36)
  dealId      String      @map("deal_id") @db.VarChar(36)
  fromStatus  DealStatus? @map("from_status")
  toStatus    DealStatus  @map("to_status")
  actorUserId String?     @map("actor_user_id") @db.VarChar(36)
  note        String?     @db.VarChar(200)
  createdAt   DateTime    @default(now()) @map("created_at") @db.DateTime(3)
  deal        Deal        @relation("deal_status_history", fields: [dealId], references: [id], onDelete: Cascade)
  actor       User?       @relation("deal_status_actor", fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([dealId, createdAt])
  @@index([actorUserId])
  @@map("deal_status_history")
}

model SavedSearch {
  id              String               @id @default(uuid()) @db.VarChar(36)
  userId          String               @map("user_id") @db.VarChar(36)
  name            String               @db.VarChar(120)
  filters         Json
  frequency       SavedSearchFrequency @default(DAILY)
  isActive        Boolean              @default(true) @map("is_active")
  lastProcessedAt DateTime?            @map("last_processed_at") @db.DateTime(3)
  createdAt       DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  user            User                 @relation("user_saved_searches", fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isActive])
  @@index([isActive, frequency])
  @@map("saved_searches")
}

model WasteCategory {
  id        String          @id @default(uuid()) @db.VarChar(36)
  name      String          @db.VarChar(120)
  slug      String          @unique @db.VarChar(140)
  parentId  String?         @map("parent_id") @db.VarChar(36)
  parent    WasteCategory?  @relation("category_tree", fields: [parentId], references: [id], onDelete: Restrict)
  children  WasteCategory[] @relation("category_tree")
  materials Material[]
  listings  Listing[]
  createdAt DateTime        @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime        @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([parentId])
  @@map("waste_categories")
}

model Material {
  id          String        @id @default(uuid()) @db.VarChar(36)
  categoryId  String        @map("category_id") @db.VarChar(36)
  name        String        @db.VarChar(160)
  slug        String        @unique @db.VarChar(180)
  defaultUnit String        @map("default_unit") @db.VarChar(20)
  riskClass   String?       @map("risk_class") @db.VarChar(40)
  category    WasteCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  listings    Listing[]
  createdAt   DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([categoryId])
  @@map("materials")
}

model Listing {
  id                 String                 @id @default(uuid()) @db.VarChar(36)
  companyId          String                 @map("company_id") @db.VarChar(36)
  createdByUserId    String                 @map("created_by_user_id") @db.VarChar(36)
  categoryId         String                 @map("category_id") @db.VarChar(36)
  materialId         String?                @map("material_id") @db.VarChar(36)
  type               ListingType
  status             ListingStatus          @default(DRAFT)
  title              String                 @db.VarChar(180)
  slug               String                 @unique @db.VarChar(220)
  description        String?                @db.Text
  quantity           Decimal                @db.Decimal(16, 3)
  availableQuantity  Decimal                @map("available_quantity") @db.Decimal(16, 3)
  unit               String                 @db.VarChar(20)
  unitPrice          Decimal?               @map("unit_price") @db.Decimal(14, 2)
  currency           String                 @default("BRL") @db.Char(3)
  frequency          ListingFrequency       @default(ONE_TIME)
  riskClassification RiskClassification     @default(UNKNOWN) @map("risk_classification")
  originDetails      String?                @map("origin_details") @db.VarChar(240)
  ownTransport       Boolean                @default(false) @map("own_transport")
  requiresDocuments  Boolean                @default(false) @map("requires_documents")
  city               String?                @db.VarChar(120)
  state              String?                @db.Char(2)
  latitude           Decimal?               @db.Decimal(10, 7)
  longitude          Decimal?               @db.Decimal(10, 7)
  publishedAt        DateTime?              @map("published_at") @db.DateTime(3)
  expiresAt          DateTime?              @map("expires_at") @db.DateTime(3)
  viewCount          Int                    @default(0) @map("view_count")
  favoriteCount      Int                    @default(0) @map("favorite_count")
  createdAt          DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  lastAccessAt       DateTime?              @map("last_access_at") @db.DateTime(3)
  deletedAt          DateTime?              @map("deleted_at") @db.DateTime(3)
  company            Company                @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy          User                   @relation("listing_creator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  category           WasteCategory          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  material           Material?              @relation(fields: [materialId], references: [id], onDelete: Restrict)
  moderationCases    ModerationCase[]
  favorites          Favorite[]
  proposals          Proposal[]
  deals              Deal[]
  conversations      Conversation[]         @relation("listing_conversations")
  media              ListingMedia[]
  reports            Report[]               @relation("report_listing")
  statusHistory      ListingStatusHistory[] @relation("listing_status_history")
  contactUnlocks     ContactUnlock[]        @relation("listing_contact_unlocks")

  @@index([status, type, publishedAt(sort: Desc)])
  @@index([categoryId, status])
  @@index([companyId, status])
  @@index([city, state, status])
  @@index([latitude, longitude])
  @@map("listings")
}

model ListingMedia {
  id               String             @id @default(uuid()) @db.VarChar(36)
  listingId        String             @map("listing_id") @db.VarChar(36)
  uploadedByUserId String             @map("uploaded_by_user_id") @db.VarChar(36)
  storageKey       String             @unique @map("storage_key") @db.VarChar(255)
  mimeType         String             @map("mime_type") @db.VarChar(80)
  sizeBytes        Int                @map("size_bytes")
  sha256           String             @db.Char(64)
  altText          String?            @map("alt_text") @db.VarChar(180)
  sortOrder        Int                @default(0) @map("sort_order")
  status           ListingMediaStatus @default(READY)
  createdAt        DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  listing          Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  uploadedBy       User               @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)

  @@unique([listingId, sortOrder])
  @@index([listingId, status, sortOrder])
  @@index([uploadedByUserId])
  @@map("listing_media")
}

model HomeCarouselSlide {
  id              String   @id @default(uuid()) @db.VarChar(36)
  position        Int      @unique
  storageKey      String   @unique @map("storage_key") @db.VarChar(255)
  mimeType        String   @map("mime_type") @db.VarChar(80)
  sizeBytes       Int      @map("size_bytes")
  sha256          String   @db.Char(64)
  altText         String   @map("alt_text") @db.VarChar(180)
  version         Int      @default(1)
  updatedByUserId String   @map("updated_by_user_id") @db.VarChar(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy       User     @relation("carousel_slide_updater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@index([updatedByUserId])
  @@map("home_carousel_slides")
}

model AuditLog {
  id           String   @id @default(uuid()) @db.VarChar(36)
  actorUserId  String?  @map("actor_user_id") @db.VarChar(36)
  action       String   @db.VarChar(80)
  resourceType String   @map("resource_type") @db.VarChar(80)
  resourceId   String?  @map("resource_id") @db.VarChar(36)
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.DateTime(3)
  actor        User?    @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([resourceType, resourceId, createdAt(sort: Desc)])
  @@index([actorUserId, createdAt(sort: Desc)])
  @@map("audit_logs")
}

model ModerationCase {
  id         String               @id @default(uuid()) @db.VarChar(36)
  listingId  String               @map("listing_id") @db.VarChar(36)
  status     ModerationCaseStatus @default(OPEN)
  reason     String?              @db.Text
  reviewedAt DateTime?            @map("reviewed_at") @db.DateTime(3)
  createdAt  DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt  DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  listing    Listing              @relation(fields: [listingId], references: [id], onDelete: Restrict)
  actions    ModerationAction[]

  @@index([status, createdAt])
  @@index([listingId, status])
  @@map("moderation_cases")
}

model ModerationAction {
  id        String               @id @default(uuid()) @db.VarChar(36)
  caseId    String               @map("case_id") @db.VarChar(36)
  actorId   String               @map("actor_id") @db.VarChar(36)
  type      ModerationActionType
  reason    String?              @db.Text
  createdAt DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  case      ModerationCase       @relation(fields: [caseId], references: [id], onDelete: Restrict)
  actor     User                 @relation(fields: [actorId], references: [id], onDelete: Restrict)

  @@index([caseId, createdAt])
  @@index([actorId, createdAt])
  @@map("moderation_actions")
}

model Favorite {
  userId    String   @map("user_id") @db.VarChar(36)
  listingId String   @map("listing_id") @db.VarChar(36)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([userId, listingId])
  @@index([listingId, createdAt])
  @@map("favorites")
}

model Proposal {
  id                String             @id @default(uuid()) @db.VarChar(36)
  listingId         String             @map("listing_id") @db.VarChar(36)
  proposerCompanyId String             @map("proposer_company_id") @db.VarChar(36)
  createdByUserId   String             @map("created_by_user_id") @db.VarChar(36)
  quantity          Decimal            @db.Decimal(16, 3)
  unitPrice         Decimal            @map("unit_price") @db.Decimal(14, 2)
  currency          String             @default("BRL") @db.Char(3)
  notes             String?            @db.Text
  validUntil        DateTime?          @map("valid_until") @db.DateTime(3)
  status            ProposalStatus     @default(PENDING)
  createdAt         DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  listing           Listing            @relation(fields: [listingId], references: [id], onDelete: Restrict)
  proposerCompany   Company            @relation("proposer_company", fields: [proposerCompanyId], references: [id], onDelete: Restrict)
  createdBy         User               @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  revisions         ProposalRevision[]
  deal              Deal?
  conversations     Conversation[]     @relation("proposal_conversations")

  @@index([listingId, status])
  @@index([proposerCompanyId, status])
  @@map("proposals")
}

model ProposalRevision {
  id          String   @id @default(uuid()) @db.VarChar(36)
  proposalId  String   @map("proposal_id") @db.VarChar(36)
  actorUserId String   @map("actor_user_id") @db.VarChar(36)
  quantity    Decimal  @db.Decimal(16, 3)
  unitPrice   Decimal  @map("unit_price") @db.Decimal(14, 2)
  notes       String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.DateTime(3)
  proposal    Proposal @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Restrict)

  @@index([proposalId, createdAt])
  @@map("proposal_revisions")
}

model Deal {
  id                  String               @id @default(uuid()) @db.VarChar(36)
  listingId           String               @map("listing_id") @db.VarChar(36)
  proposalId          String               @unique @map("proposal_id") @db.VarChar(36)
  buyerCompanyId      String               @map("buyer_company_id") @db.VarChar(36)
  sellerCompanyId     String               @map("seller_company_id") @db.VarChar(36)
  status              DealStatus           @default(OPEN)
  createdAt           DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt           DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  listing             Listing              @relation(fields: [listingId], references: [id], onDelete: Restrict)
  proposal            Proposal             @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  buyerCompany        Company              @relation("buyer_company", fields: [buyerCompanyId], references: [id], onDelete: Restrict)
  sellerCompany       Company              @relation("seller_company", fields: [sellerCompanyId], references: [id], onDelete: Restrict)
  conversation        Conversation?
  paymentTransactions PaymentTransaction[]
  logisticsRequests   LogisticsRequest[]
  statusHistory       DealStatusHistory[]  @relation("deal_status_history")
  reviews             Review[]

  @@index([listingId, status])
  @@index([buyerCompanyId, status])
  @@index([sellerCompanyId, status])
  @@map("deals")
}

model PaymentTransaction {
  idempotencyKey String        @unique @map("idempotency_key") @db.VarChar(100)
  id             String        @id @default(uuid()) @db.VarChar(36)
  dealId         String        @map("deal_id") @db.VarChar(36)
  companyId      String        @map("company_id") @db.VarChar(36)
  provider       String        @db.VarChar(40)
  externalId     String?       @unique @map("external_id") @db.VarChar(180)
  amount         Decimal       @db.Decimal(14, 2)
  currency       String        @default("BRL") @db.Char(3)
  status         PaymentStatus @default(INITIATED)
  checkoutUrl    String?       @map("checkout_url") @db.Text
  metadata       Json?
  paidAt         DateTime?     @map("paid_at") @db.DateTime(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.DateTime(3)
  deal           Deal          @relation(fields: [dealId], references: [id], onDelete: Restrict)
  company        Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@index([dealId, status])
  @@index([companyId, createdAt])
  @@map("payment_transactions")
}

model LogisticsRequest {
  id                String                 @id @default(uuid()) @db.VarChar(36)
  dealId            String                 @map("deal_id") @db.VarChar(36)
  requestedByUserId String                 @map("requested_by_user_id") @db.VarChar(36)
  origin            String                 @db.VarChar(300)
  destination       String                 @db.VarChar(300)
  quantity          Decimal                @db.Decimal(16, 3)
  unit              String                 @db.VarChar(20)
  pickupWindow      String?                @map("pickup_window") @db.VarChar(160)
  requirements      String?                @db.Text
  status            LogisticsRequestStatus @default(REQUESTED)
  createdAt         DateTime               @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.DateTime(3)
  deal              Deal                   @relation(fields: [dealId], references: [id], onDelete: Restrict)
  requestedBy       User                   @relation(fields: [requestedByUserId], references: [id], onDelete: Restrict)
  quotes            LogisticsQuote[]

  @@index([dealId, status])
  @@index([requestedByUserId, createdAt])
  @@map("logistics_requests")
}

model LogisticsQuote {
  id             String               @id @default(uuid()) @db.VarChar(36)
  requestId      String               @map("request_id") @db.VarChar(36)
  quotedByUserId String               @map("quoted_by_user_id") @db.VarChar(36)
  carrierName    String               @map("carrier_name") @db.VarChar(200)
  amount         Decimal              @db.Decimal(14, 2)
  currency       String               @default("BRL") @db.Char(3)
  estimatedDays  Int?                 @map("estimated_days")
  notes          String?              @db.Text
  status         LogisticsQuoteStatus @default(ACTIVE)
  createdAt      DateTime             @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.DateTime(3)
  request        LogisticsRequest     @relation(fields: [requestId], references: [id], onDelete: Restrict)
  quotedBy       User                 @relation(fields: [quotedByUserId], references: [id], onDelete: Restrict)

  @@index([requestId, status])
  @@map("logistics_quotes")
}

model Conversation {
  id           String                    @id @default(uuid()) @db.VarChar(36)
  listingId    String?                   @map("listing_id") @db.VarChar(36)
  proposalId   String?                   @unique @map("proposal_id") @db.VarChar(36)
  dealId       String?                   @unique @map("deal_id") @db.VarChar(36)
  createdAt    DateTime                  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime                  @updatedAt @map("updated_at") @db.DateTime(3)
  listing      Listing?                  @relation("listing_conversations", fields: [listingId], references: [id], onDelete: Restrict)
  proposal     Proposal?                 @relation("proposal_conversations", fields: [proposalId], references: [id], onDelete: Restrict)
  deal         Deal?                     @relation(fields: [dealId], references: [id], onDelete: Restrict)
  participants ConversationParticipant[]
  messages     Message[]

  @@index([listingId, updatedAt])
  @@map("conversations")
}

model ConversationParticipant {
  conversationId String       @map("conversation_id") @db.VarChar(36)
  userId         String       @map("user_id") @db.VarChar(36)
  joinedAt       DateTime     @default(now()) @map("joined_at") @db.DateTime(3)
  lastReadAt     DateTime?    @map("last_read_at") @db.DateTime(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([conversationId, userId])
  @@index([userId, lastReadAt])
  @@map("conversation_participants")
}

model Message {
  id             String       @id @default(uuid()) @db.VarChar(36)
  conversationId String       @map("conversation_id") @db.VarChar(36)
  senderUserId   String       @map("sender_user_id") @db.VarChar(36)
  body           String       @db.Text
  createdAt      DateTime     @default(now()) @map("created_at") @db.DateTime(3)
  editedAt       DateTime?    @map("edited_at") @db.DateTime(3)
  deletedAt      DateTime?    @map("deleted_at") @db.DateTime(3)
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation(fields: [senderUserId], references: [id], onDelete: Restrict)
  reports        Report[]     @relation("report_message")

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Notification {
  id        String           @id @default(uuid()) @db.VarChar(36)
  userId    String           @map("user_id") @db.VarChar(36)
  type      NotificationType
  title     String           @db.VarChar(160)
  body      String           @db.Text
  payload   Json?
  readAt    DateTime?        @map("read_at") @db.DateTime(3)
  createdAt DateTime         @default(now()) @map("created_at") @db.DateTime(3)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

model AuthToken {
  id        String        @id @default(uuid()) @db.VarChar(36)
  userId    String        @map("user_id") @db.VarChar(36)
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash") @db.VarChar(128)
  expiresAt DateTime      @map("expires_at") @db.DateTime(3)
  usedAt    DateTime?     @map("used_at") @db.DateTime(3)
  createdAt DateTime      @default(now()) @map("created_at") @db.DateTime(3)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type, expiresAt])
  @@map("auth_tokens")
}

model Plan {
  id           String         @id @default(uuid()) @db.VarChar(36)
  code         String         @unique @db.VarChar(60)
  name         String         @db.VarChar(120)
  description  String?        @db.Text
  priceMonthly Decimal        @map("price_monthly") @db.Decimal(14, 2)
  currency     String         @default("BRL") @db.Char(3)
  features     Json?
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    DateTime       @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt    DateTime       @updatedAt @map("updated_at") @db.DateTime(3)
  subscriptions Subscription[]

  @@index([isActive])
  @@map("plans")
}

model Subscription {
  id                 String             @id @default(uuid()) @db.VarChar(36)
  companyId          String             @map("company_id") @db.VarChar(36)
  planId             String             @map("plan_id") @db.VarChar(36)
  provider           String             @default("INTERNAL") @db.VarChar(40)
  externalId         String?            @map("external_id") @db.VarChar(180)
  status             SubscriptionStatus @default(PENDING)
  currentPeriodStart DateTime?          @map("current_period_start") @db.DateTime(3)
  currentPeriodEnd   DateTime?          @map("current_period_end") @db.DateTime(3)
  cancelAt           DateTime?          @map("cancel_at") @db.DateTime(3)
  cancelledAt        DateTime?          @map("cancelled_at") @db.DateTime(3)
  createdAt          DateTime           @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.DateTime(3)
  company            Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  plan               Plan               @relation(fields: [planId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([planId, status])
  @@index([status, currentPeriodEnd])
  @@map("subscriptions")
}

model Review {
  id                String   @id @default(uuid()) @db.VarChar(36)
  dealId            String   @map("deal_id") @db.VarChar(36)
  authorUserId      String   @map("author_user_id") @db.VarChar(36)
  authorCompanyId   String   @map("author_company_id") @db.VarChar(36)
  reviewedCompanyId String   @map("reviewed_company_id") @db.VarChar(36)
  rating            Int
  comment           String?  @db.Text
  createdAt         DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  deal              Deal     @relation(fields: [dealId], references: [id], onDelete: Restrict)
  authorUser        User     @relation("review_author", fields: [authorUserId], references: [id], onDelete: Restrict)
  authorCompany     Company  @relation("review_reviewer_company", fields: [authorCompanyId], references: [id], onDelete: Restrict)
  reviewedCompany   Company  @relation("review_reviewed_company", fields: [reviewedCompanyId], references: [id], onDelete: Restrict)

  @@unique([dealId, authorCompanyId])
  @@index([reviewedCompanyId, createdAt(sort: Desc)])
  @@index([authorUserId])
  @@index([authorCompanyId])
  @@map("reviews")
}

model ContactUnlock {
  id        String              @id @default(uuid()) @db.VarChar(36)
  companyId String              @map("company_id") @db.VarChar(36)
  listingId String              @map("listing_id") @db.VarChar(36)
  userId    String              @map("user_id") @db.VarChar(36)
  source    ContactUnlockSource @default(ONE_TIME)
  createdAt DateTime            @default(now()) @map("created_at") @db.DateTime(3)
  company   Company             @relation("company_contact_unlocks", fields: [companyId], references: [id], onDelete: Restrict)
  listing   Listing             @relation("listing_contact_unlocks", fields: [listingId], references: [id], onDelete: Restrict)
  user      User                @relation("contact_unlock_user", fields: [userId], references: [id], onDelete: Restrict)

  @@unique([companyId, listingId])
  @@index([listingId])
  @@index([userId, createdAt])
  @@map("contact_unlocks")
}

model PlatformSetting {
  key             String   @id @db.VarChar(80)
  value           Json
  updatedByUserId String?  @map("updated_by_user_id") @db.VarChar(36)
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.DateTime(3)
  updatedBy       User?    @relation("platform_setting_updater", fields: [updatedByUserId], references: [id], onDelete: Restrict)

  @@map("platform_settings")
}

model OutboxEvent {
  id            String            @id @default(uuid()) @db.VarChar(36)
  type          String            @db.VarChar(80)
  aggregateType String?           @map("aggregate_type") @db.VarChar(60)
  aggregateId   String?           @map("aggregate_id") @db.VarChar(36)
  payload       Json
  status        OutboxEventStatus @default(PENDING)
  attempts      Int               @default(0)
  availableAt   DateTime          @default(now()) @map("available_at") @db.DateTime(3)
  processedAt   DateTime?         @map("processed_at") @db.DateTime(3)
  lastError     String?           @map("last_error") @db.Text
  createdAt     DateTime          @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime          @updatedAt @map("updated_at") @db.DateTime(3)

  @@index([status, availableAt])
  @@index([aggregateType, aggregateId])
  @@map("outbox_events")
}
