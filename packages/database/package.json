{
  "name": "@loopambiental/database",
  "private": true,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "generate": "prisma generate",
    "db:push": "tsx --env-file=../../.env node_modules/prisma/build/index.js db push",
    "db:migrate": "tsx --env-file=../../.env node_modules/prisma/build/index.js migrate dev",
    "db:deploy": "tsx --env-file=../../.env node_modules/prisma/build/index.js migrate deploy",
    "db:status": "tsx --env-file=../../.env node_modules/prisma/build/index.js migrate status",
    "db:validate": "tsx --env-file=../../.env node_modules/prisma/build/index.js validate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "prisma": "^6.2.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
